{
  "manifest_version": 3,
  "name": "Bug Hunt Tracker",
  "version": "1.0.0",
  "description": "Low-friction personal bug bounty tracker: one-tap session timer, programs, findings and automatic analytics. 100% local.",
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Bug Hunt Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/app/app.html",
  "minimum_chrome_version": "102"
}
